# 环境配置
# 复制此文件为 .env 并填入实际值

# 应用配置
APP_NAME=FlowShelf API
APP_VERSION=1.0.0
DEBUG=true

# 数据库
DATABASE_URL=sqlite+aiosqlite:///./flowshelf.db

# AI 配置
# DEMO_MODE=true 时使用模拟数据，false 时调用真实 API
DEMO_MODE=true
OPENAI_API_KEY=sk-test-placeholder
AI_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
AI_MAX_TOKENS=500
AI_TEMPERATURE=0.3

# 服务器
HOST=0.0.0.0
PORT=8000

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001"]

# 正文抽取
MAX_CONTENT_LENGTH=50000
CONTENT_TIMEOUT=10