# ============================================
# FlowShelf .gitignore
# 排除敏感信息、依赖包、临时文件等
# ============================================

# ---------- 环境配置（敏感） ----------
.env
.model_cache/
.env.local
.env.*.local
*.pem
*.key

# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
venv/
.venv/
env/
*.egg-info/
dist/
build/
*.egg
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ---------- Node.js / Frontend ----------
node_modules/
.next/
out/
dist/
.turbo/
*.tsbuildinfo

# ---------- 浏览器扩展 ----------
flowshelf-extension/build/
flowshelf-extension/.plasmo/

# ---------- 数据库 ----------
*.db
*.sqlite
*.sqlite3
flowshelf.db

# ---------- IDE 配置 ----------
.idea/
.vscode/
*.swp
*.swo
*~

# ---------- 操作系统 ----------
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db

# ---------- 日志 ----------
*.log
logs/

# ---------- 临时文件 ----------
tmp/
temp/
*.tmp
*.bak
*.orig

# ---------- 依赖包 ----------
*.tar.gz
*.zip

# ---------- Alembic ----------
backend/alembic/versions/*.pyc


.trae/*
