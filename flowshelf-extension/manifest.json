{
  "manifest_version": 3,
  "name": "FlowShelf",
  "version": "0.1.0",
  "description": "AI 原生的个人数字资产管家 - 浏览器扩展",
  "icons": {
    "16": "assets/icon512.png",
    "128": "assets/icon512.png",
    "512": "assets/icon512.png"
  },
  "action": {
    "default_title": "FlowShelf",
    "default_popup": "src/popup/index.html",
    "default_icon": "assets/icon512.png"
  },
  "options_ui": {
    "page": "src/options/index.html",
    "open_in_tab": true
  },
  "chrome_url_overrides": {
    "newtab": "src/newtab/index.html"
  },
  "permissions": ["storage", "tabs", "tabGroups", "activeTab", "contextMenus", "scripting", "bookmarks", "notifications"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["http://localhost:3000/*", "http://127.0.0.1:3000/*", "https://*.flowshelf.app/*"],
      "js": ["src/content/bridge.ts"],
      "run_at": "document_start"
    }
  ],
  "background": {
    "service_worker": "src/background/index.ts",
    "type": "module"
  },
  "commands": {
    "collect-current-page": {
      "suggested_key": {
        "default": "Ctrl+Shift+S",
        "mac": "Command+Shift+S"
      },
      "description": "收藏当前页面到 FlowShelf"
    }
  }
}
